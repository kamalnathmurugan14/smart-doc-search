# Folder with YOUR documents (pdf, docx, txt, md). Windows example: C:/Users/you/Documents/docs
DOCS_ROOT=./sample_docs
# Where the SQLite index lives (git-ignored)
DATA_DIR=./data
# Upload size limit in MB
MAX_UPLOAD_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt,md
# sentence-transformers model name, or "hashing" for the offline lexical fallback
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE_CHARS=1000
CHUNK_OVERLAP_CHARS=150
# 0 = keyword only, 1 = semantic only (hybrid blend)
HYBRID_ALPHA=0.5
# Near-duplicate cosine threshold on file-level embeddings
DUP_NEAR_THRESHOLD=0.92
# Shingle-Jaccard confirmation for near duplicates
DUP_JACCARD_MIN=0.5
CORS_ORIGINS=http://localhost:5173
TAG_RULES_PATH=./rules/tags.yaml
